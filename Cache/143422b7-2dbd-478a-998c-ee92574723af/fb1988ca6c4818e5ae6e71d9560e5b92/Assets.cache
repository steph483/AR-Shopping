- !<TypeScriptAssetData/4dbaada5-89aa-44bf-9ce8-f707888c5484>
  SvgIcon: ""
  SetupScript:
    code: ""
  Description: ""
  VersionMajor: 0
  VersionMinor: 0
  VersionPatch: 0
  ComponentUid: f5ccc8e2-4e8d-4daa-b65b-e5a48b6e0ee8
